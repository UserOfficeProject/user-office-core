{
  "name": "@user-office-core/pdf-renderer",
  "version": "1.0.0",
  "description": "Browser-free PDF renderer. Handlebars template + data in, PDF out, using Typst as the PDF engine.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "pdf-renderer": "build/cli.js"
  },
  "type": "commonjs",
  "private": true,
  "author": "SWAP",
  "license": "ISC",
  "scripts": {
    "build": "rm -rf ./build && tsc",
    "test": "env NODE_ENV=test jest --config ./jest.config.js --colors",
    "test:watch": "env NODE_ENV=test jest --config ./jest.config.js --watch",
    "lint": "tsc --noEmit && eslint ./src --quiet",
    "lint:all": "tsc --noEmit && eslint ./src",
    "lint:fix": "tsc --noEmit && eslint ./src --fix --quiet",
    "render": "ts-node ./src/cli.ts"
  },
  "dependencies": {
    "@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
    "dom-typst": "^0.1.14",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/jest": "^29.5.6",
    "@types/node": "^22.13.10",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "prettier": "3.2.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.46.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
