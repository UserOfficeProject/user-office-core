FROM node:22-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY package-lock.json* ./

# Copy the entire app (needed for build step)
COPY apps ./apps
COPY validation ./validation

# Install production dependencies only
RUN npm install

# Build the backend
RUN cd apps/backend && npm run build:validation && npm run generate:uows

# Build the backend
RUN cd apps/backend && npm run build

# Set working directory to backend
WORKDIR /app/apps/backend

# Use node as entrypoint so Argo can pass the job name as argument
ENTRYPOINT ["node"]

# Default command (can be overridden by Argo)
CMD ["build/src/asyncJobs/runJob.js"]
